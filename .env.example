# Copy to .env to override the defaults baked into docker-compose.yml.
# These are local-dev-only defaults (localhost, not exposed externally) —
# not intended as production secrets.
POSTGRES_USER=flood_admin
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=flood_risk_ktm

# Pre-processed Nepal-wide OSM extract on Cloudflare R2 (buildings/roads/
# waterways as plain GeoJSON) -- osm.py's fallback when no local
# *.osm.pbf covers the requested AOI. Leave unset for local dev if you
# have a local .pbf under backend/data/raw/osm/; only needed for a
# deployment with no local file. Public object URLs (R2's own r2.dev
# subdomain, or a custom domain), not signed/private URLs -- osm.py does
# a plain unauthenticated GET.
OSM_R2_BUILDINGS_URL=
OSM_R2_ROADS_URL=
OSM_R2_WATERWAYS_URL=
