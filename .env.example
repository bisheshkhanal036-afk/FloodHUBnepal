# Copy to .env to override the defaults baked into docker-compose.yml.
# These are local-dev-only defaults (localhost, not exposed externally) —
# not intended as production secrets.
POSTGRES_USER=flood_admin
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=flood_risk_ktm

# Pre-processed Nepal-wide OSM extract on Cloudflare R2 (buildings/roads/
# waterways as geometry-only FlatGeobuf, .fgb -- the same files
# backend/data/raw/osm/processed/ holds locally, see that directory's
# README for how they're built) -- osm.py's fallback when no local
# *.osm.pbf/*.fgb covers the requested AOI. Leave unset for local dev if
# you have local files under backend/data/raw/osm/; only needed for a
# deployment with no local files. Public object URLs (R2's own r2.dev
# subdomain, or a custom domain) ending in .fgb, not signed/private URLs
# -- osm.py does a plain unauthenticated bbox-filtered partial read
# (FlatGeobuf's HTTP range-request support), not a whole-file download.
OSM_R2_BUILDINGS_URL=
OSM_R2_ROADS_URL=
OSM_R2_WATERWAYS_URL=
